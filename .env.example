# Variables de entorno de DeCulto
# Copia este fichero a .env y rellena los valores reales.
# Nunca subas .env al control de versiones.

# Obligatorias: URL, usuario y contraseña de la base de datos, y perfil activo
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/deculto_dev
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_PROFILES_ACTIVE=dev

# Opcional: clave de API de TMDB (vacía en esta fase)
TMDB_API_KEY=
